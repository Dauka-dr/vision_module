__pycache__/
*.pyc
*.egg-info/

# --- модели -----------------------------------------------------------------
# Веса RTMDet и RTMPose скачиваются сами при первом запуске (pipeline.py).
models/*.pth
# Кроме обученных нами — их взять больше негде:
#   target7   — рабочий классификатор действий, без него не будет действий
#   ntu60     — backbone для дообучения на своих классах; это 3 часа обучения,
#               которые иначе пришлось бы повторять
!models/stgcnpp_target7.pth
!models/stgcnpp_ntu60_epoch12.pth

# --- данные -----------------------------------------------------------------
# Тестовая сцена (13 МБ) тянется скриптом fetch_assets.py.
test_scenes/*.jpg
test_scenes/*.png
# Выборка NTU (143 МБ) пересобирается: python build_subset.py
dataset/annotations/*.pkl
# Своя съёмка и извлечённые из неё скелеты
dataset/raw/**/*
dataset/skeletons/**/*
!dataset/**/.gitkeep

# --- рабочее ----------------------------------------------------------------
work_dirs/
data/
# Аннотированные картинки и текстовые отчёты замеров — пересоздаются
# командой python metrics/run_all.py
bench_out/
metrics/results/
demo_out.jpg
*.mp4

# Клон OpenMMLab, ставится install.ps1
mmaction2/
